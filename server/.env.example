# Porta em que o servidor Express sobe
PORT=3333

# Origem permitida no CORS (o app mobile/web do AteliêSP), com suporte a cookies
CORS_ORIGIN=http://localhost:8081

# TODO (próxima etapa): gerar um segredo forte, ex.: `openssl rand -hex 32`
JWT_SECRET=troque-este-valor

# Nome do cookie httpOnly que vai guardar o JWT
JWT_COOKIE_NAME=ateliesp_token

# Tempo de expiração do token
JWT_EXPIRES_IN=7d

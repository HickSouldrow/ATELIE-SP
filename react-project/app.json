
{
  "expo": {
    "name": "AteliêSP",
    "slug": "ateliesp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ateliesp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.ateliesp.app"
    },
    "android": {
      "package": "br.com.ateliesp.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#100B1A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#100B1A"
        }
      ],
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "O AteliêSP usa a câmera para você fotografar as obras que registrar.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O AteliêSP usa sua localização para marcar no mapa onde cada obra foi registrada."
        }
      ]
    ]
  }
}

